# Copy to .env (or export in your shell). Nothing here is required for backtests.

# Market data source: binance (public mirror, no key needed) or indodax
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Starting paper capital (quote currency: USDT for binance, IDR for indodax)
INITIAL_CASH=1000

# Costs. TAX_SELL_RATE defaults by exchange if unset:
#   indodax -> 0.0021 (PPh final 0.21%, PMK 50/2025, domestic exchange)
#   binance -> 0.01   (1% for foreign exchanges under the same rule)
FEE_RATE=0.001
# TAX_SELL_RATE=0.0021
SLIPPAGE_BPS=5

# Risk limits (enforced in code, Claude cannot override them)
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.5
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.15
COOLDOWN_BARS=3

# Claude reviewer: off | advisory | required
#   off      -> never called (default; backtests are free)
#   advisory -> called on every entry; may veto or reduce size; API errors fall through to approve
#   required -> API errors or refusals veto the trade (fail-safe)
CLAUDE_REVIEW=off
CLAUDE_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# LIVE EXECUTION (real money). Everything below is ignored while EXECUTION=paper.
# Live mode keeps its own state/journal/dashboard in data/live/ by default.
# ---------------------------------------------------------------------------
EXECUTION=paper                    # paper | live
# LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY   # must be exactly this phrase to allow real orders
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# EXCHANGE_API_PASSWORD=           # only for exchanges that use one
# EXCHANGE_SANDBOX=1               # Binance spot testnet (testnet.binance.vision); Indodax/Tokocrypto have none
MAX_ORDER_NOTIONAL=100             # quote currency per order (USDT on Binance, IDR on Indodax)
MAX_DAILY_ORDERS=10
EXCHANGE_STOP=0                    # 1 = keep a stop-limit sell on the exchange (Binance/Tokocrypto only)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Local (OJK-licensed) exchanges: EXCHANGE=indodax SYMBOL=BTC/IDR  or  EXCHANGE=tokocrypto SYMBOL=BTC/USDT
# International:                  EXCHANGE=binance SYMBOL=BTC/USDT
